## 3. Data Models (MongoDB)

```mermaid
erDiagram
    User ||--o{ Project : "owns"
    User ||--o{ UserSubscription : "has"
    User ||--o{ Invitation : "receives"
    User ||--o{ Request : "sends"
    User ||--o{ Starred : "stars"
    User ||--o{ Payment : "makes"
    User ||--o{ Comment : "writes"

    Project ||--|| Room : "has"
    Project ||--o{ Discover : "listed in"
    Project ||--o{ Comment : "has"
    Project ||--o{ Starred : "starred by"

    Room ||--o{ Message : "contains"
    Room ||--o{ Invitation : "receives"
    Room ||--o{ Request : "receives"

    Subscription ||--o{ UserSubscription : "defines"
    UserSubscription ||--o{ Payment : "billed by"

    User { string id; string email; string avatar }
    Project { string id; string name; string language }
    Room { string id; string[] memberIds }
    Subscription { string id; string tier; number price }
    UserSubscription { string id; string status; date expiry }
    Payment { string id; string status; number amount }
    Message { string id; string content; date createdAt }
    Comment { string id; string text }
    Starred { string id }
    Invite { string id; string status }
    Request { string id; string status }
    Discover { string id; boolean isPublic }
```

